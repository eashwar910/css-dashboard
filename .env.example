# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Server-side variables have NO VITE_ prefix so Vite never bundles them.

# ── Browser (Vite) ───────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Server (/api) ────────────────────────────────────────────────────────────
# Same values as the VITE_ pair above. Used to verify sessions and read committee_members.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Notion internal integration token (css-dashboard connection)
NOTION_TOKEN=ntn_your-notion-integration-token

# Notion data source IDs (see NOTION_MAPPING.md)
NOTION_TASKS_DS_ID=00000000-0000-0000-0000-000000000000
NOTION_EVENTS_DS_ID=00000000-0000-0000-0000-000000000000
NOTION_MEETINGS_DS_ID=00000000-0000-0000-0000-000000000000
NOTION_EXCO_DS_ID=00000000-0000-0000-0000-000000000000
NOTION_DOCUMENTS_DS_ID=00000000-0000-0000-0000-000000000000
NOTION_TRANSACTIONS_DS_ID=00000000-0000-0000-0000-000000000000
